# Local .terraform directories
.terraform/

# By default, .tfstate files can contain sensitive information, so
# you should not commit them into version control. See the
# documentation for more details:
# https://www.terraform.io/docs/state/sensitive-data.html
*.tfstate
*.tfstate.*

# An optional plan file created by terraform plan
*.tfplan
*.tfplan.*

# Crash log files
crash.log
crash.*.log

# Exclude override files as they are usually used for local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include TFID files generated by some providers
.terraform.tfstate.lock.info

# Sensitive variables/credentials files (ex: terraform.tfvars, *.auto.tfvars)
# Descomente a linha abaixo se você costuma salvar credenciais em arquivos locais e não quer versioná-los por engano:
# *.tfvars
# *.auto.tfvars

# Ignore CLI configuration files for local testing
.terraformrc
terraform.rc
